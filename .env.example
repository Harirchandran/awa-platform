# Safe local configuration template. Replace every placeholder before use.
# Host-mode backend processes load backend/.env.local; scripts/dev/init-project.ps1
# creates it from this template. Docker Compose reads the root .env copy instead.
# Real credentials must remain outside Git.

# Shared local/development modes
ENV=local
LOG_LEVEL=INFO
AWA_INTEGRATION_MODE=test
AUTH_MODE=postgres
WHATSAPP_MODE=test
BILLING_MODE=test

ENABLE_MOCK_AUTH=false
ENABLE_MOCK_SUPER_ADMIN=false
ENABLE_WEBHOOK_SIGNATURE_BYPASS=false
ENABLE_MOCK_BILLING=false
ENABLE_MOCK_WHATSAPP_SIGNUP=false

# Local service passwords used by the Docker-hosted PostgreSQL and Redis services.
# The password embedded in each host-mode URL must match its corresponding value.
POSTGRES_PASSWORD=generate_a_strong_local_password
REDIS_PASSWORD=generate_a_strong_local_password

# Host-mode backend and development-script connectivity uses 127.0.0.1.
# Enter complete URLs: .env files do not recursively expand password variables.
# Docker services override these URLs with internal hostnames postgres and redis.
DATABASE_URL=postgresql://postgres:replace_with_the_same_postgres_password@127.0.0.1:5432/postgres
REDIS_URL=redis://:replace_with_the_same_redis_password@127.0.0.1:6379/0

JWT_SECRET=generate_at_least_32_random_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

OPENAI_API_KEY=replace_with_openai_api_key
GROQ_API_KEY=replace_with_groq_api_key
GEMINI_API_KEY=replace_with_gemini_api_key
ROUTING_LLM_PROVIDER=groq
AGENT_LLM_PROVIDER=groq

WHATSAPP_API_TOKEN=replace_with_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=generate_a_random_verify_token
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id
WHATSAPP_TOKEN_ENCRYPTION_KEY=generate_a_fernet_compatible_key

PUBLIC_CHAT_LINK_SECRET=generate_at_least_32_random_bytes
PUBLIC_CHAT_SESSION_SECRET=generate_at_least_32_random_bytes
AWA_PUBLIC_CHAT_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

RAZORPAY_KEY_ID=replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret

FACEBOOK_APP_ID=replace_with_meta_app_id
FACEBOOK_APP_SECRET=replace_with_meta_app_secret
FACEBOOK_CONFIG_ID=replace_with_meta_config_id

# Frontend build-time variables. Mock features remain disabled unless explicitly
# enabled for a local development build. The Turnstile site key is optional in
# local mode and required only when the backend CAPTCHA mode is turnstile.
VITE_ENABLE_MOCK_AUTH=false
VITE_ENABLE_MOCK_WHATSAPP_SIGNUP=false
VITE_TURNSTILE_SITE_KEY=

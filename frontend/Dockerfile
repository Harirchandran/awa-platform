# Build stage
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Pass arguments to environment variables for Vite build
ARG VITE_FACEBOOK_APP_ID
ARG VITE_FACEBOOK_CONFIG_ID
ARG VITE_FACEBOOK_GRAPH_VERSION
ARG VITE_WHATSAPP_SIGNUP_VIDEO_URL
ARG VITE_AWA_INTEGRATION_MODE
ARG VITE_WHATSAPP_MODE
ARG VITE_ENABLE_MOCK_AUTH
ARG VITE_ENABLE_MOCK_WHATSAPP_SIGNUP
ARG VITE_TURNSTILE_SITE_KEY

ENV VITE_FACEBOOK_APP_ID=$VITE_FACEBOOK_APP_ID
ENV VITE_FACEBOOK_CONFIG_ID=$VITE_FACEBOOK_CONFIG_ID
ENV VITE_FACEBOOK_GRAPH_VERSION=$VITE_FACEBOOK_GRAPH_VERSION
ENV VITE_WHATSAPP_SIGNUP_VIDEO_URL=$VITE_WHATSAPP_SIGNUP_VIDEO_URL
ENV VITE_AWA_INTEGRATION_MODE=$VITE_AWA_INTEGRATION_MODE
ENV VITE_WHATSAPP_MODE=$VITE_WHATSAPP_MODE
ENV VITE_ENABLE_MOCK_AUTH=$VITE_ENABLE_MOCK_AUTH
ENV VITE_ENABLE_MOCK_WHATSAPP_SIGNUP=$VITE_ENABLE_MOCK_WHATSAPP_SIGNUP
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY

RUN npm run build

# Production stage
FROM nginx:1.29-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
